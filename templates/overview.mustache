{{!
    @template block_tarsus/overview

    The block's content: the learner's standing per Tarsus activity, a
    "continue" link, and the teacher's per-activity summary.

    Context variables required for this template:
    * activities - array of {name, url, progress, hasfigures, hastest, hasbuild, xp, totalxp, units, totalunits,
      hasgrade, grade, trackscompletion, completed}.
    * hascontinue, continue - {name, url}.
    * isteacher, summary - array of {name, url, started, avgprogress, hasgrades, avggrade, completed}.
}}
<div class="block_tarsus__overview">
    {{#hascontinue}}
    <a class="btn btn-primary btn-sm w-100 mb-3 block_tarsus__continue" href="{{continue.url}}">
        {{#str}}continue_in, block_tarsus, {{continue.name}}{{/str}}
    </a>
    {{/hascontinue}}
    <ul class="list-unstyled mb-0">
        {{#activities}}
        <li class="block_tarsus__activity mb-3">
            <div class="d-flex justify-content-between align-items-baseline">
                <a class="block_tarsus__name fw-bold" href="{{url}}">{{name}}</a>
                <span class="small text-muted">{{progress}}%</span>
            </div>
            <div class="progress block_tarsus__progress my-1" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                 aria-valuenow="{{progress}}" aria-label="{{#str}}progress, block_tarsus{{/str}}">
                <div class="progress-bar" style="width: {{progress}}%"></div>
            </div>
            <div class="small text-muted block_tarsus__figures">
                {{#hastest}}<span>{{xp}} / {{totalxp}} {{#str}}xp, block_tarsus{{/str}}</span>{{/hastest}}
                {{#hasbuild}}<span>{{units}} / {{totalunits}} {{#str}}lu, block_tarsus{{/str}}</span>{{/hasbuild}}
                {{#hasgrade}}<span>{{#str}}grade, block_tarsus{{/str}}: {{grade}}</span>{{/hasgrade}}
                {{#trackscompletion}}
                <span class="{{#completed}}text-success{{/completed}}">
                    {{#completed}}{{#str}}completed, block_tarsus{{/str}}{{/completed}}
                    {{^completed}}{{#str}}notcompleted, block_tarsus{{/str}}{{/completed}}
                </span>
                {{/trackscompletion}}
            </div>
        </li>
        {{/activities}}
    </ul>
    {{#isteacher}}
    <h6 class="mt-3 mb-2">{{#str}}coursesummary, block_tarsus{{/str}}</h6>
    <ul class="list-unstyled mb-0 block_tarsus__summary">
        {{#summary}}
        <li class="mb-2">
            <a class="block_tarsus__name fw-bold" href="{{url}}">{{name}}</a>
            <div class="small text-muted block_tarsus__figures">
                <span>{{#str}}started, block_tarsus{{/str}}: {{started}}</span>
                <span>{{#str}}avgprogress, block_tarsus{{/str}}: {{avgprogress}}%</span>
                <span>{{#str}}avggrade, block_tarsus{{/str}}: {{#hasgrades}}{{avggrade}}{{/hasgrades}}{{^hasgrades}}–{{/hasgrades}}</span>
                <span>{{#str}}completedcount, block_tarsus{{/str}}: {{completed}}</span>
            </div>
        </li>
        {{/summary}}
    </ul>
    {{/isteacher}}
</div>
