{{!
    @template block_tarsus/ring

    A progress ring: a light track and a round-capped accent stroke whose
    dash offset leaves the earned share visible; the percentage sits in
    the middle. Same geometry as the ring on the learning-unit card
    (r=9 in a 24 viewBox, circumference 56.55).

    Context variables required for this template:
    * size - number, the rendered size in px.
    * progress - number, 0..100.
    * ringoffset - string, the stroke offset (see overview::ring_offset()).
    * ringlabel - string, the accessible name.
}}
<span class="block_tarsus__ring" style="--block-tarsus-ring: {{size}}px">
    <svg viewBox="0 0 24 24" width="{{size}}" height="{{size}}" role="img" aria-label="{{ringlabel}} {{progress}}%">
        <circle class="block_tarsus__ring-track" cx="12" cy="12" r="9"></circle>
        <circle class="block_tarsus__ring-fill" cx="12" cy="12" r="9" style="stroke-dashoffset: {{ringoffset}}"></circle>
    </svg>
    <span class="block_tarsus__ring-value" aria-hidden="true">{{progress}}%</span>
</span>
